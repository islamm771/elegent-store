generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  newsletter   Boolean  @default(true)
  measurements Json?
  addresses    Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

enum BadgeTone {
  dark
  accent
  danger
  light
}

model Product {
  id             String     @id @default(cuid())
  slug           String     @unique // used in URLs, cart and wishlist: /shop/<slug>
  name           String
  label          String // short attribute line, e.g. "Normandy flax"
  description    String?
  category       String // dresses | tops | trousers | outerwear | accessories
  departments    String[] // women | men | kids
  material       String // flax-linen | mulberry-silk | cashmere | organic-cotton | wool-lyocell
  colors         String[] // color ids, first one is the default
  sizes          String[] // xs | s | m | l | xl
  images         String[] // gallery URLs, first one is the main image
  tone           String     @default("#d9c4a4") // placeholder colour shown until the photo loads
  priceCents     Int // 14500 = $145.00
  compareAtCents Int? // original price when on sale
  rating         Float      @default(0)
  reviewCount    Int        @default(0)
  badgeText      String?
  badgeTone      BadgeTone?
  oeko           Boolean    @default(false)
  trending       Boolean    @default(false)
  stock          Int        @default(0) // total units available
  isActive       Boolean    @default(true) // hide a product without deleting it
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([category])
  @@index([isActive, createdAt])
}
