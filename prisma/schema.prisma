generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  newsletter   Boolean  @default(true)
  measurements Json?
  addresses    Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cartItems     CartItem[] // the shopping bag
  wishlistItems WishlistItem[]
  orders        Order[]
}

/// One line in a user's shopping bag. Same product in a different colour/size is a different line.
model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  color     String   @default("") // colour title, "" when the product has no colour choice
  size      String   @default("") // xs | s | m | l | xl, "" when not applicable
  qty       Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // "" (not NULL) for colour/size so this constraint actually dedupes in Postgres
  @@unique([userId, productId, color, size])
  @@index([userId, createdAt])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

enum BadgeTone {
  dark
  accent
  danger
  light
}

model Product {
  id             String     @id @default(cuid())
  slug           String     @unique // used in URLs, cart and wishlist: /shop/<slug>
  name           String
  label          String // short attribute line, e.g. "Normandy flax"
  description    String?
  category       String // dresses | tops | trousers | outerwear | accessories
  departments    String[] // women | men | kids
  material       String // flax-linen | mulberry-silk | cashmere | organic-cotton | wool-lyocell
  colors         String[] // color ids, first one is the default
  sizes          String[] // xs | s | m | l | xl
  images         String[] // gallery URLs, first one is the main image
  tone           String     @default("#d9c4a4") // placeholder colour shown until the photo loads
  priceCents     Int // 14500 = $145.00
  compareAtCents Int? // original price when on sale
  rating         Float      @default(0)
  reviewCount    Int        @default(0)
  badgeText      String?
  badgeTone      BadgeTone?
  oeko           Boolean    @default(false)
  trending       Boolean    @default(false)
  stock          Int        @default(0) // total units available
  isActive       Boolean    @default(true) // hide a product without deleting it
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@index([category])
  @@index([isActive, createdAt])
}

enum PaymentMethod {
  COD // cash on delivery
  ONLINE // paid by card through Stripe Checkout
}

enum PaymentStatus {
  PENDING // COD: collected by the courier on delivery · ONLINE: waiting for the customer to pay
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING // placed, waiting for payment (online) or for us to confirm (COD)
  CONFIRMED
  PACKED // hand-packaged, waiting for the courier
  SHIPPED // out for delivery
  DELIVERED
  CANCELLED
}

model Order {
  id            String        @id @default(cuid())
  number        String        @unique // human readable, e.g. EL-7K2P9QXD
  userId        String
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  subtotalCents Int
  shippingCents Int
  taxCents      Int           @default(0)
  totalCents    Int

  email    String
  phone    String
  shipping Json // { name, line1, line2, city, postal, country, notes }

  stripeSessionId String?   @unique // Stripe Checkout Session of an ONLINE order
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([userId, createdAt])
}

/// A frozen copy of what was bought: name, image and price are copied so later catalogue edits never rewrite an old order.
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String? // null if the product was deleted afterwards
  slug      String
  name      String
  image     String?
  color     String  @default("")
  size      String  @default("")
  qty       Int
  unitCents Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}
